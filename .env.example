# ─────────────────────────────────────────────────────────────────────────────
# Argus — environment variable TEMPLATE
# Copy this file to `.env` and fill in the values. `.env` is NEVER committed.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
ARGUS_ENV=dev                  # dev | prod
ARGUS_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
ARGUS_LOG_FORMAT=console       # console (colored, development) | json (prod)
ARGUS_TIMEZONE=Europe/Istanbul

# ── Event bus (Redis) ────────────────────────────────────────────────────────
ARGUS_REDIS_URL=redis://localhost:6379/0

# ── Database (SQLite, zero setup) ────────────────────────────────────────────
ARGUS_DATABASE_URL=sqlite:///data/argus.db

# ── Data providers (all optional; a source without a key is skipped) ─────────
# TCMB EVDS macro series key (https://evds2.tcmb.gov.tr, free registration).
ARGUS_EVDS_KEY=
# News APIs (free tiers).
ARGUS_CRYPTOPANIC_TOKEN=
ARGUS_FINNHUB_KEY=

# ── LLM providers ────────────────────────────────────────────────────────────
# Keys are per provider, not per role. Leave unused providers empty.
ANTHROPIC_API_KEY=
# Reserved: accepted by the settings page, but no OpenAI/OpenRouter client is implemented yet.
ARGUS_OPENAI_API_KEY=
ARGUS_OPENROUTER_API_KEY=
# Global fallback provider: claude (Anthropic API, paid) | ollama (local LLM, free).
# For Ollama: install from https://ollama.com, run `ollama pull llama3.2`, then set
# ARGUS_LLM_PROVIDER=ollama.
ARGUS_LLM_PROVIDER=claude
ARGUS_OLLAMA_BASE_URL=http://localhost:11434
ARGUS_OLLAMA_MODEL=llama3.2
# Daily LLM cost ceiling (USD) — enforced by the cost governor.
ARGUS_LLM_DAILY_BUDGET_USD=3.0
# Per-role provider (claude | ollama). Empty falls back to
# ARGUS_LLM_PROVIDER. Roles: routine (scans/alerts), deep (/analyze), copilot (cockpit chat),
# news_router (news classification), exchange_expert (BIST expert agent).
ARGUS_PROVIDER_ROUTINE=
ARGUS_PROVIDER_DEEP=
ARGUS_PROVIDER_COPILOT=
ARGUS_PROVIDER_NEWS_ROUTER=
ARGUS_PROVIDER_EXCHANGE_EXPERT=ollama
# Per-role model id; the name depends on the provider (claude-..., llama3.2, gpt-4o, ...).
ARGUS_MODEL_ROUTINE=claude-sonnet-4-6
ARGUS_MODEL_DEEP=claude-opus-4-8
ARGUS_MODEL_COPILOT=claude-sonnet-4-6
ARGUS_MODEL_NEWS_ROUTER=claude-sonnet-4-6
# Empty falls back to ARGUS_OLLAMA_MODEL.
ARGUS_MODEL_EXCHANGE_EXPERT=
# Include the exchange expert agent in the confluence set.
ARGUS_ENABLE_EXCHANGE_EXPERT=true

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Authorized users — comma-separated list of chat ids.
ARGUS_AUTHORIZED_CHAT_IDS=

# ── Dashboard / web cockpit ──────────────────────────────────────
# Users as "name:hash,name2:hash2" — passwords are NEVER stored in plain text. Generate a hash:
#   python -c "from argus.api.security import hash_password; print(hash_password('<password>'))"
# Empty disables cockpit authentication (local development only).
ARGUS_DASHBOARD_USERS=
# Session-cookie signing key (empty: random per process; sessions drop on restart).
ARGUS_DASHBOARD_SESSION_SECRET=
# Interface/port to listen on — defaults to localhost. Do NOT bind publicly; keep it behind
# a VPN or similar.
ARGUS_DASHBOARD_BIND=127.0.0.1
ARGUS_DASHBOARD_PORT=8787
# Allowed CORS origins (comma-separated). NOT needed when the frontend runs behind the Vite
# proxy (port 3000, same origin). If the frontend calls the backend directly:
# http://localhost:3000
ARGUS_DASHBOARD_CORS_ORIGINS=

# ── Market data / webhooks ───────────────────────────────────────────────────
# The Binance market-data integration uses public endpoints only; this release has no private
# account, signing or order adapter, so no exchange API key is accepted.
# Optional; the endpoint stays closed unless tradingview_enabled=true in the config.
ARGUS_TRADINGVIEW_WEBHOOK_SECRET=
