{
  "name": "argus-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Argus web cockpit (React frontend for the Argus API). Not financial advice.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/react-grid-layout": "^2.1.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.3.0"
  },
  "comment_overrides": "react-grid-layout 1.5.3 passes nodeRef to react-draggable (StrictMode compatibility). react-draggable 4.6.0 dropped nodeRef support, which breaks drag/resize. Keep it pinned to 4.4.6 (the last version with nodeRef).",
  "overrides": {
    "react-draggable": "4.4.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.6.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.60.0",
